# Copy these into Replit "Secrets" (lock icon) — do NOT commit real values.

# Required — your RentCast API key (https://app.rentcast.io/app/api)
RENTCAST_API_KEY=your_rentcast_key_here

# Optional — POST every captured lead to this URL (HubSpot/Zapier/Make/your CRM).
# Leave blank to only log leads locally to leads.ndjson.
LEAD_WEBHOOK_URL=
